<main class="page">
  <div class="query">
    <p class="echo">
      <span class="muted">Usage since</span> <code><%= @since %></code>
      <% if @summary["last_use"].present? %>
        <span class="muted">· last use <%= @summary["last_use"].to_time.strftime("%b %d, %Y") %></span>
      <% end %>
    </p>
    <div class="since-links">
      <% [ [ "Since #{Usage::DEFAULT_SINCE}", Usage::DEFAULT_SINCE ],
            [ "Last 90 days", 90.days.ago.to_date.to_s ],
            [ "All", "2000-01-01" ] ].each do |label, value| %>
        <%= link_to label, admin_usage_path(since: value), class: "button#{" active" if @since == value}" %>
      <% end %>
    </div>
  </div>

  <div class="cards">
    <div class="card">
      <span class="label">Registered users</span>
      <span class="value"><%= @summary["registered"] %></span>
    </div>
    <div class="card">
      <span class="label">Users who searched</span>
      <span class="value"><%= @summary["searched"] %></span>
      <span class="note">of <%= @summary["registered"] %> accounts</span>
    </div>
    <div class="card">
      <span class="label">Searches</span>
      <span class="value"><%= @summary["searches"] %></span>
    </div>
    <div class="card">
      <span class="label">Exports</span>
      <span class="value"><%= @summary["exports"] %></span>
    </div>
  </div>

  <div class="split">
    <div class="panel">
      <div class="panel-head">
        <h2>Searches per week</h2>
      </div>
      <% if @by_week.empty? %>
        <p class="hint">No activity in this period.</p>
      <% else %>
        <% max_searches = [ @by_week.map { |row| row["searches"].to_i }.max, 1 ].max %>
        <div class="bars">
          <% @by_week.each do |row| %>
            <div class="bar-col">
              <div class="bar" style="height: <%= (row["searches"].to_i * 100.0 / max_searches).round(1) %>%"
                   title="<%= row["week"] %>: <%= row["searches"] %> searches, <%= row["users"] %> users"></div>
              <span class="bar-label"><%= row["week"] %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="card">
      <span class="label">No-results rate</span>
      <span class="value"><%= @no_results_rate %>%</span>
      <span class="note">of searches found zero part keys</span>
    </div>
  </div>

  <div class="split">
    <div class="panel">
      <div class="panel-head">
        <h2>Who uses it <span class="count">(<%= @by_user.size %>)</span></h2>
      </div>
      <table>
        <thead>
          <tr>
            <th>Email</th>
            <th class="num">Searches</th>
            <th class="num">Exports</th>
            <th>Last search</th>
          </tr>
        </thead>
        <tbody>
          <% @by_user.each do |row| %>
            <tr>
              <td><%= row["email"] %></td>
              <td class="num"><%= row["searches"] %></td>
              <td class="num"><%= row["exports"] %></td>
              <td class="muted"><%= row["last_search"]&.to_time&.strftime("%Y-%m-%d %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="panel">
      <div class="panel-head">
        <h2>Search types</h2>
      </div>
      <table>
        <thead>
          <tr>
            <th>Type</th>
            <th class="num">Searches</th>
            <th class="num">Users</th>
          </tr>
        </thead>
        <tbody>
          <% @by_search_type.each do |row| %>
            <tr>
              <td><%= row["search_type"] %></td>
              <td class="num"><%= row["searches"] %></td>
              <td class="num"><%= row["users"] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head">
      <h2>Never searched <span class="count">(<%= @never_searched.size %>)</span></h2>
    </div>
    <% if @never_searched.any? %>
      <table>
        <thead>
          <tr>
            <th>Email</th>
            <th class="num">Sign-ins</th>
            <th>Last sign-in</th>
          </tr>
        </thead>
        <tbody>
          <% @never_searched.each do |row| %>
            <tr>
              <td><%= row["email"] %></td>
              <td class="num"><%= row["sign_in_count"] %></td>
              <td class="muted"><%= row["last_sign_in_at"]&.to_time&.strftime("%Y-%m-%d %H:%M") || "never" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hint">Every account has searched at least once.</p>
    <% end %>
  </div>
</main>
