-# locals: (keys:, detail:, demand:)
-# Each searched key's rows of the Demand Comparison report: how this week's
-# demand differs from last week's, inside lead time and in total.
- rows, snapshots, history = detail.demand_rows, detail.demand_weeks, detail.history
- if rows.empty?
  %p.hint The Demand Comparison report carries none of these parts.
- keys.each do |key|
  - next unless rows[key.id]
  %section.panel
    %header.panel-head
      %h2= key_code(key)
      %span= demand_pill(demand[key.id])
    .table-wrap
      %table
        %thead
          %tr
            %th FPN
            %th{ title: "The report's Customer Name column, which holds the Flex site" } Site
            %th Ship-to
            %th.num Eff. lead time
            %th Status
            %th.num{ title: "Pieces of demand that moved inside lead time since last week's snapshot" } Inside LT
            %th.num Total
        %tbody
          - rows[key.id].each do |row|
            %tr
              %td= row.fpn || "—"
              %td= row.customer_name || "—"
              %td= row.ship_address || "—"
              %td.num= row.eff_lead_time ? "#{row.eff_lead_time} days" : "—"
              %td= row.status || "—"
              %td.num= demand_change(row.lt_variation, row.lt_variation_pct)
              %td.num= demand_change(row.total_variation, row.total_variation_pct)
    .charts
      .chart-box
        %h3 Demand by week: last week vs this week
        - if (weeks, old, new = snapshots[key.id])
          = week_chart(weeks,
                       [ { name: "Last week's snapshot", values: old, kind: :line, tone: "previous" },
                         { name: "This week's snapshot", values: new, kind: :line, tone: "primary" } ],
                       label: "Demand by week in last week's and this week's snapshot, for #{key.key_value}")
          %p.caption Pieces, from the Demand Comparison report.
        - else
          %p.hint This week's report did not carry the weekly snapshots.
      .chart-box
        %h3 Total demand, week over week
        - points = history[key.id].to_a.select(&:demand_total)
        = week_chart(points.map(&:week),
                     [ { name: "Total demand", values: points.map(&:demand_total), kind: :line, tone: "primary" } ],
                     label: "Total demand in each weekly report, for #{key.key_value}")
        %p.caption= history_note(points.map(&:week))
