-# locals: (summary:, buffer: {}, commit: {}, demand: {})
-# SUMMARY!B4:B9 plus the combo count from E6, ordered by importance. Risk is Excel parity: RED when any line has CDD > PDD.
- late = summary[:misses].positive?
%section.cards
  -# Red or green only: no rule says what is YELLOW yet, so nothing is.
  .card.risk{ class: late ? "red" : "green" }
    %span.label Execution risk
    %span.value
      = late ? "RED" : "GREEN"
      - if late
        %svg{ width: "28", height: "28", viewBox: "0 0 24 24", fill: "none", "aria-hidden": "true" }
          %path{ d: "M12 3.5L2.8 19.5h18.4L12 3.5z", stroke: "currentColor", "stroke-width": "2", "stroke-linejoin": "round" }
          %path{ d: "M12 10v4.2", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round" }
          %circle{ cx: "12", cy: "17", r: "1.2", fill: "currentColor" }
      - else
        %svg{ width: "28", height: "28", viewBox: "0 0 24 24", fill: "none", "aria-hidden": "true" }
          %circle{ cx: "12", cy: "12", r: "9", stroke: "currentColor", "stroke-width": "2" }
          %path{ d: "M8 12.5l2.7 2.7L16 9.8", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round" }
    %span.note= late ? "#{pluralize(summary[:misses], "late line")} · CDD > PDD" : "no late lines"

  .card
    %span.label Open lines
    %span.value= number_with_delimiter(summary[:open_lines])
    %span.note= "#{number_with_delimiter(summary[:open_qty].to_i)} pcs ordered"

  .card
    %span.label ETD range
    %span.value.range
      = short_date(summary[:etd_min])
      %span.arrow →
      = short_date(summary[:etd_max])
    %span.note earliest and latest CDD

  -# Least decision-relevant of the four, so last and smaller.
  .card.minor
    %span.label Combinations
    %span.value= summary[:combos_found]
    %span.note CPN|MPN keys

-# The supply side of Alejandro's mockup: each source's worst key, so the
-# dashboard says where to look before the tables do. The words carry the
-# state; the red only repeats it.
%section.cards.supply
  - targeted = buffer.values.reject(&:no_target?)
  - low = targeted.min_by(&:min_vs_ss)
  .card{ class: ("bad" if low&.below_target?) }
    %span.label Lowest buffer
    - if low
      %span.value= buffer_ratio(low.min_vs_ss)
      %span.note= low.below_target? ? "below safety stock · #{pluralize(targeted.count(&:below_target?), "key")}" : "every key at or above its safety stock"
    - else
      %span.value —
      %span.note= buffer.any? ? "no safety stock agreed" : "not in the Buffer Readiness report"

  - short = commit.values.select(&:short?).min_by(&:min_balance)
  .card{ class: ("bad" if short) }
    %span.label Commit
    - if short
      %span.value= "Short #{short_qty(short.min_balance)}"
      %span.note= "pcs of forecast uncovered, from #{short_date(short.short_from)}"
    - else
      %span.value= commit.any? ? "Covered" : "—"
      %span.note= commit.any? ? "every week has a commitment" : "not in the Customer Commitment report"

  - moved = demand.values.max_by { |position| position.lt_variation_pct.to_d.abs }
  .card{ class: ("bad" if moved && !moved.steady?) }
    %span.label Demand inside LT
    - if moved
      %span.value= signed_percent(moved.lt_variation_pct)
      %span.note= "#{moved.label} · #{demand_change(moved.lt_variation, nil)} pcs since last week"
    - else
      %span.value —
      %span.note not in the Demand Comparison report
