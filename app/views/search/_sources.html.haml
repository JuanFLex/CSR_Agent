-# locals: (sources:)
-# One chip per source. A source never loaded says so instead of showing a number.
%ul.sources
  - sources.each do |type, snapshot|
    - if snapshot
      %li.source.live.freshness
        %span.dot>
        %strong= t("sources.#{type}")
        #{snapshot.fresh_as_of&.strftime("%b %d, %H:%M") || "—"} ·
        %code= snapshot.source_file
        · ##{snapshot.id}
    - else
      %li.source.not-loaded
        %span.dot>
        #{t("sources.#{type}")} · not loaded
