-# locals: (keys:, context:, buffer:)
-# A key can span several FPNs, customers or plants. The Excel had to pick one;
-# here they are all listed, and a key spanning more than one is marked,
-# because that is precisely where the workbook misreports.
-# Buffer is the key's own position, taken across every buffer row it has.
%section.panel
  %header.panel-head
    %h2
      Part keys
      %span.count= "(#{keys.size})"
    - if context.any? { |_id, ctx| spans_many?(ctx) }
      %span.multi-hint
        %span.swatch>
        More than one value — check which one the customer means
  %table.keys
    %thead
      %tr
        %th Key (CPN|MPN)
        %th FPN
        %th Customer
        %th Plant
        %th{ title: "Lowest week of the projected balance against safety stock (1× is on target)" } Buffer
        %th{ title: "First week the projected balance is at or above safety stock" } At target from
    %tbody
      - keys.each do |key|
        - ctx = context[key.id] || {}
        %tr
          %td
            %code= key.key_value
          - SearchHelper::KEY_DIMENSIONS.each do |dimension|
            - values = Array(ctx[dimension])
            %td{ class: ("multi" if values.many?) }
              = values.presence&.join(" · ") || "—"
              - if values.many?
                %span.badge= values.size
          - position = buffer[key.id]
          %td= buffer_pill(position)
          %td= short_date(position&.at_target_from)
