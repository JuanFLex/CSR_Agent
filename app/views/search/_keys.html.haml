-# locals: (keys:, context:, buffer:, commit:)
-# A key can span several FPNs, customers or plants. The Excel had to pick one;
-# here they are all listed, and a key spanning more than one is marked,
-# because that is precisely where the workbook misreports.
-# Buffer and Commit are the key's own position, taken across every row it has
-# in each report.
%section.panel
  %header.panel-head
    %h2
      Part keys
      %span.count= "(#{keys.size})"
  -# The amber cell alone is a colour; the alert says what it means.
  - conflicts = key_conflicts(keys, context)
  - if conflicts.any?
    .alert.amber{ role: "status" }
      %svg{ width: "16", height: "16", viewBox: "0 0 24 24", fill: "none", "aria-hidden": "true" }
        %path{ d: "M12 3.5L2.8 19.5h18.4L12 3.5z", stroke: "currentColor", "stroke-width": "2", "stroke-linejoin": "round" }
        %path{ d: "M12 10v4.2", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round" }
        %circle{ cx: "12", cy: "17", r: "1.2", fill: "currentColor" }
      %ul
        - conflicts.each do |key, label, values|
          %li
            - if keys.many?
              = key_code(key)
            %strong= "#{label} has #{values.size} values (#{values.join(" · ")})."
            = "Confirm with the customer which #{label == "FPN" ? label : label.downcase} applies before committing a date."
  .table-wrap
    %table.keys
      %thead
        %tr
          %th Key (CPN|MPN)
          %th FPN
          %th Sold-to
          %th Plant
          %th{ title: "Lowest week of the projected balance against safety stock (1× is on target), and the first week at or above it" } Buffer
          %th{ title: "Most pieces of forecast left without a commitment in any week, and the first week that happens" } Commit
      %tbody
        - keys.each do |key|
          - ctx = context[key.id] || {}
          %tr
            %td= key_code(key)
            - SearchHelper::KEY_DIMENSIONS.each do |dimension|
              - values = Array(ctx[dimension])
              %td{ class: ("multi" if values.many?) }
                = values.presence&.join(" · ") || "—"
                - if values.many?
                  %span.badge= values.size
            - position = buffer[key.id]
            %td
              = buffer_pill(position)
              - if position&.at_target_from
                %span.since= "at target from #{short_date(position.at_target_from)}"
            - position = commit[key.id]
            %td
              = commit_pill(position)
              - if position&.short_from
                %span.since= "from #{short_date(position.short_from)}"
