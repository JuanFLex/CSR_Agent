<%# locals: (summary:) %>
<%# SUMMARY!B4:B9 plus the combo count from E6. Risk is Excel parity: RED when any line has CDD > PDD. %>
<% late = summary[:misses].positive? %>
<section class="cards">
  <div class="card risk <%= late ? "red" : "green" %>">
    <span class="label">Execution risk</span>
    <span class="value">
      <%= late ? "RED" : "GREEN" %>
      <% if late %>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.5L2.8 19.5h18.4L12 3.5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 10v4.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="17" r="1.2" fill="currentColor"/></svg>
      <% else %>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M8 12.5l2.7 2.7L16 9.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <% end %>
    </span>
    <span class="note"><%= late ? "#{pluralize(summary[:misses], "late line")} · CDD > PDD" : "no late lines" %></span>
  </div>

  <div class="card">
    <span class="label">Combinations</span>
    <span class="value"><%= summary[:combos_found] %></span>
    <span class="note">CPN|MPN keys</span>
  </div>

  <div class="card">
    <span class="label">Open lines</span>
    <span class="value"><%= number_with_delimiter summary[:open_lines] %></span>
    <span class="note"><%= number_with_delimiter summary[:open_qty].to_i %> pcs ordered</span>
  </div>

  <div class="card">
    <span class="label">ETD range</span>
    <span class="value range"><%= short_date(summary[:etd_min]) %> <span class="arrow">→</span> <%= short_date(summary[:etd_max]) %></span>
    <span class="note">earliest and latest CDD</span>
  </div>
</section>
