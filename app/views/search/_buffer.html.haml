-# locals: (keys:, detail:, buffer:)
-# Each searched key's rows of the Buffer Readiness report. The pill in the
-# header is the key's position, the same one the Part keys table shows.
- rows, projections, history = detail.buffer_rows, detail.buffer_weeks, detail.history
- if rows.empty?
  %p.hint The Buffer Readiness report carries none of these parts.
- keys.each do |key|
  - next unless rows[key.id]
  %section.panel
    %header.panel-head
      %h2= key_heading(key)
      = buffer_pill(buffer[key.id])
    .table-wrap
      %table
        %thead
          %tr
            %th FPN
            %th Site
            %th Supplier
            %th Customer ID
            %th Ship-to
            %th.num Safety stock
            %th.num{ title: "Allocated Customer On Hand, as the report names it" } Allocated on hand
            %th.num{ title: "Allocated on hand as a multiple of the safety stock: the report's Buffer % Coverage" } Coverage
            %th.num{ title: "Lowest week of the projected balance against safety stock; 1× is on target" } Lowest vs SS
            %th At target from
        %tbody
          - rows[key.id].each do |row|
            %tr
              %td= row.fpn || "—"
              %td= row.site || "—"
              %td= row.supplier || "—"
              %td= row.customer_id || "—"
              %td= row.ship_address || "—"
              %td.num= number_with_delimiter(row.safety_stock.to_i)
              %td.num= number_with_delimiter(row.allocated_on_hand.to_i)
              - if row.no_target?
                %td.num{ colspan: 2 }
                  %span.pill.unconfirmed No target
                %td —
              - else
                %td.num= buffer_ratio(row.coverage)
                %td.num= buffer_ratio(row.min_vs_ss)
                %td= short_date(row.at_target_from)
    .charts
      .chart-box
        %h3 Projected balance vs safety stock
        - if (weeks = projections[key.id])
          = week_chart(weeks.map(&:first),
                       [ { name: "Projected balance", values: weeks.map(&:second), kind: :line, tone: "primary" },
                         { name: "Safety stock", values: weeks.map(&:third), kind: :reference, tone: "reference" } ],
                       label: "Projected balance against safety stock, week by week, for #{key.key_value}")
          %p.caption Pieces, from this week's report. Below the dashed line the part is into its buffer.
        - else
          %p.hint No safety stock agreed: nothing to measure the balance against.
      .chart-box
        %h3 Allocated on hand, week over week
        - points = history[key.id].to_a.select(&:allocated_on_hand)
        = week_chart(points.map(&:week),
                     [ { name: "Allocated on hand", values: points.map(&:allocated_on_hand), kind: :line, tone: "primary" },
                       { name: "Safety stock", values: points.map(&:safety_stock), kind: :reference, tone: "reference" } ],
                     label: "Allocated on hand against safety stock in each weekly report, for #{key.key_value}")
        %p.caption= history_note(points.map(&:week))
