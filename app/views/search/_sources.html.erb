<%# locals: (sources:) %>
<%# One chip per source. A source never loaded says so instead of showing a number. %>
<ul class="sources">
  <% sources.each do |type, snapshot| %>
    <% if snapshot %>
      <li class="source live freshness">
        <span class="dot"></span><strong><%= t("sources.#{type}") %></strong>
        <%= snapshot.fresh_as_of&.strftime("%b %d, %H:%M") || "—" %>
        · <code><%= snapshot.source_file %></code> · #<%= snapshot.id %>
      </li>
    <% else %>
      <li class="source not-loaded"><span class="dot"></span><%= t("sources.#{type}") %> · not loaded</li>
    <% end %>
  <% end %>
</ul>
