-# locals: (lines:, summary:, search:, columns:, page:, pages:)
-# The default set answers "is this order going to land on time". Everything
-# tOSOR shows is one checkbox away — see _column_picker.
%section.panel
  %header.panel-head
    %h2
      Open orders
      %span.count= "(#{number_with_delimiter(summary[:open_lines])})"
    .tools
      = render "column_picker", model: Csr::OsorLine, columns: columns, param: :line_columns, search: search
      = render "export_link", table: "lines", param: :line_columns, columns: columns, search: search

  -# shown, not columns: the pager links below must carry the reader's choice,
  -# or the controller would remember it without the MPN.
  - shown = screen_columns(search, columns)
  = render "mpn_note", search: search if shown != columns
  .table-wrap
    %table.lines
      %thead
        %tr
          - shown.each do |column|
            %th{ class: ("num" if Csr::OsorLine.numeric_column?(column)) }= Csr::OsorLine::COLUMNS[column]
          %th Risk
      %tbody
        - lines.each do |line|
          %tr{ class: ("miss" if line.miss) }
            - shown.each do |column|
              %td{ class: ("num" if Csr::OsorLine.numeric_column?(column)) }= column_cell(line, column)
            %td= risk_pill(line)
  -# Pages ride in the URL like the columns do; the export is never paged. A key
  -# known only to Buffer or Commit has no open orders at all.
  %footer.table-foot
    - if summary[:open_lines].zero?
      %span.muted No open orders
    - else
      - first = (page - 1) * Csr::SearchRequest::LINES_PER_PAGE + 1
      %span.muted
        = "Showing #{number_with_delimiter(first)}–#{number_with_delimiter(first + lines.size - 1)} of #{number_with_delimiter(summary[:open_lines])}"
        · sorted by ETD (CDD), earliest first
    - if pages > 1
      - link = ->(to) { url_for(request.path_parameters.merge(search_type: search.search_type, value: search.value, region: search.region, line_columns: columns, page: to)) }
      %nav.pager{ "aria-label": "Open orders pages" }
        - if page > 1
          = link_to "‹", link.(page - 1), class: "button", "aria-label": "Previous page"
        %span.muted= "Page #{page} of #{pages}"
        - if page < pages
          = link_to "›", link.(page + 1), class: "button", "aria-label": "Next page"
