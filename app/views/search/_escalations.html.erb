<%# locals: (escalations:, columns:, search:) %>
<%# Escalations attach by MPN, not by the CPN|MPN key: a FET carries no CPN, so
    one escalation can belong to several keys. It is listed against the MPN it
    was raised on, and never folded into the risk card — the Excel's rule for
    that ("Priority contains RED") has no column behind it. %>
<section class="panel">
  <header class="panel-head">
    <h2>Escalations (FET) <span class="count">(<%= escalations.size %>)</span></h2>
    <% if (down = escalations.count(&:line_down?)).positive? %>
      <span class="multi-hint"><span class="pill late">Line down</span><%= pluralize(down, "escalation") %></span>
    <% end %>
  </header>

  <%# CSR_FET carries far more than a table can show at once, and which columns
      matter depends on who is reading. The choice rides in the URL, so a search
      can be shared with it, and sticks in a cookie for the next visit. %>
  <details class="columns">
    <summary>Columns (<%= columns.size %> of <%= Csr::Escalation::COLUMNS.size %>)</summary>
    <%= form_with url: root_path, method: :get, data: { turbo_frame: "results" }, class: "column-picker" do %>
      <%= hidden_field_tag :search_type, search.search_type %>
      <%= hidden_field_tag :value, search.value %>
      <%= hidden_field_tag :region, search.region %>
      <div class="choices">
        <% Csr::Escalation::COLUMNS.each do |column, label| %>
          <label>
            <%= check_box_tag "columns[]", column, columns.include?(column), id: "column-#{column}" %>
            <%= label %>
          </label>
        <% end %>
      </div>
      <%= submit_tag "Apply", name: nil, class: "button primary" %>
    <% end %>
  </details>

  <table class="escalations">
    <thead>
      <tr>
        <% columns.each do |column| %>
          <th class="<%= "num" if escalation_numeric_column?(column) %>"><%= Csr::Escalation::COLUMNS[column] %></th>
        <% end %>
        <th>Flags</th>
      </tr>
    </thead>
    <tbody>
      <% escalations.each do |escalation| %>
        <tr class="<%= "miss" if escalation.line_down? %>">
          <% columns.each do |column| %>
            <td class="<%= "num" if escalation_numeric_column?(column) %>"><%= escalation_cell(escalation, column) %></td>
          <% end %>
          <td>
            <% if escalation.line_down? %><span class="pill late">Line down</span><% end %>
            <% if escalation.item_on_allocation == "Y" %><span class="pill unconfirmed">Allocation</span><% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
