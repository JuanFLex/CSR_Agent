<%# locals: (escalations:, columns:, search:) %>
<%# Escalations attach by MPN, not by the CPN|MPN key: a FET carries no CPN, so
    one escalation can belong to several keys. It is listed against the MPN it
    was raised on, and never folded into the risk card — the Excel's rule for
    that ("Priority contains RED") has no column behind it. %>
<section class="panel">
  <header class="panel-head">
    <h2>Escalations (FET) <span class="count">(<%= escalations.size %>)</span></h2>
    <% if (down = escalations.count(&:line_down?)).positive? %>
      <span class="multi-hint"><span class="pill late">Line down</span><%= pluralize(down, "escalation") %></span>
    <% end %>
  </header>

  <%= render "column_picker", model: Csr::Escalation, columns: columns, param: :escalation_columns, search: search %>

  <table class="escalations">
    <thead>
      <tr>
        <% columns.each do |column| %>
          <th class="<%= "num" if Csr::Escalation.numeric_column?(column) %>"><%= Csr::Escalation::COLUMNS[column] %></th>
        <% end %>
        <th>Flags</th>
      </tr>
    </thead>
    <tbody>
      <% escalations.each do |escalation| %>
        <tr class="<%= "miss" if escalation.line_down? %>">
          <% columns.each do |column| %>
            <td class="<%= "num" if Csr::Escalation.numeric_column?(column) %>"><%= column_cell(escalation, column) %></td>
          <% end %>
          <td>
            <% if escalation.line_down? %><span class="pill late">Line down</span><% end %>
            <% if escalation.item_on_allocation == "Y" %><span class="pill unconfirmed">Allocation</span><% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
